<Window x:Class="MapDTM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MapDTM"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:wf="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:zg="clr-namespace:ZedGraph;assembly=ZedGraph"
        mc:Ignorable="d"
        Title="MapDTM" Height="850" Width="1300" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="320" MinWidth="200" />
    </Grid.ColumnDefinitions>

    <!-- Left: map (2/3) + chart (1/3) -->
    <Grid Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="2*" />
        <RowDefinition Height="5" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <wv2:WebView2 x:Name="MapView" Grid.Row="0" />

      <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#DDD" />

      <wf:WindowsFormsHost Grid.Row="2">
        <zg:ZedGraphControl x:Name="ProfileGraph" />
      </wf:WindowsFormsHost>
    </Grid>

    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#DDD" />

    <!-- Right: points list + actions -->
    <DockPanel Grid.Column="2" Margin="6">
      <TextBlock DockPanel.Dock="Top" Text="Points (click the map to add)" FontWeight="Bold" Margin="0,0,0,6" />

      <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
        <TextBlock x:Name="StatusText" Margin="0,0,0,6" TextWrapping="Wrap" Foreground="Gray" />
        <UniformGrid Columns="3">
          <Button x:Name="CalculateButton" Content="Calculate" Margin="0,0,3,0" Padding="4" FontWeight="Bold" Click="CalculateButton_Click" />
          <Button Content="Undo last" Margin="3,0" Padding="4" Click="UndoButton_Click" />
          <Button Content="Clear" Margin="3,0,0,0" Padding="4" Click="ClearButton_Click" />
        </UniformGrid>
      </StackPanel>

      <DataGrid x:Name="PointsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                CanUserSortColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Dist [m]" Binding="{Binding Dist, StringFormat=F1}" Width="*" />
          <DataGridTextColumn Header="Lat" Binding="{Binding Lat, StringFormat=F6}" Width="*" />
          <DataGridTextColumn Header="Lon" Binding="{Binding Lon, StringFormat=F6}" Width="*" />
          <DataGridTextColumn Header="Alt [m]" Binding="{Binding Alt, StringFormat=F1}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
  </Grid>
</Window>
